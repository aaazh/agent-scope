#!/bin/bash
# 每次分支切换后自动重建 .claude/skills 和 .codex/skills 的 junction

REPO_ROOT="$(git rev-parse --show-toplevel)"
AGENT_SKILLS="$REPO_ROOT/.agent/skills"
CLAUDE_SKILLS="$REPO_ROOT/.claude/skills"
CODEX_SKILLS="$REPO_ROOT/.codex/skills"

setup_junction() {
  local target="$1"
  local source="$2"
  if [ -L "$target" ] || [ -d "$target" ]; then
    cmd //c "rmdir \"$(cygpath -w "$target" 2>/dev/null || echo "$target")\"" 2>/dev/null
    rm -f "$target" 2>/dev/null
  fi
  cmd //c "mklink /J \"$(cygpath -w "$target" 2>/dev/null || echo "$target")\" \"$(cygpath -w "$source" 2>/dev/null || echo "$source")\"" >/dev/null 2>&1
}

[ -d "$AGENT_SKILLS" ] && setup_junction "$CLAUDE_SKILLS" "$AGENT_SKILLS"
[ -d "$AGENT_SKILLS" ] && setup_junction "$CODEX_SKILLS" "$AGENT_SKILLS"
