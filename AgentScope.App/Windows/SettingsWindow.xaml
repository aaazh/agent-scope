<Window x:Class="AgentScope.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentScope 设置"
        Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab bar -->
        <TabControl Grid.Row="0">
            <TabItem Header="通用">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="语言:" Width="120" VerticalAlignment="Center" />
                        <ComboBox x:Name="LanguageCombo" Width="150">
                            <ComboBoxItem Content="中文" Tag="zh-CN" />
                            <ComboBoxItem Content="English" Tag="en-US" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheck" Content="开机自启" Margin="0,4" />
                    <CheckBox x:Name="MinimizeToTrayCheck" Content="最小化到托盘" Margin="0,4" IsChecked="True" />
                </StackPanel>
            </TabItem>

            <TabItem Header="外观">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="吸附边缘:" Width="120" VerticalAlignment="Center" />
                        <ComboBox x:Name="DockEdgeCombo" Width="150">
                            <ComboBoxItem Content="上" Tag="top" IsSelected="True" />
                            <ComboBoxItem Content="右" Tag="right" />
                            <ComboBoxItem Content="下" Tag="bottom" />
                            <ComboBoxItem Content="左" Tag="left" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="紧凑条宽度:" Width="120" VerticalAlignment="Center" />
                        <TextBox x:Name="WidthBox" Width="60" Text="320" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="透明度:" Width="120" VerticalAlignment="Center" />
                        <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" Value="0.9" Width="150" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="展开延迟 (ms):" Width="120" VerticalAlignment="Center" />
                        <TextBox x:Name="ExpandDelayBox" Width="60" Text="300" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="通知">
                <StackPanel Margin="12">
                    <CheckBox x:Name="EnableSoundCheck" Content="启用音效" Margin="0,4" IsChecked="True" />
                    <CheckBox x:Name="EnableToastCheck" Content="启用 Toast 通知" Margin="0,4" IsChecked="True" />
                    <StackPanel Margin="0,8">
                        <TextBlock Text="事件通知开关:" FontWeight="Bold" />
                        <CheckBox Content="权限请求" IsChecked="True" Margin="0,2" />
                        <CheckBox Content="工具调用失败" IsChecked="True" Margin="0,2" />
                        <CheckBox Content="子代理启动/停止" IsChecked="True" Margin="0,2" />
                        <CheckBox Content="Session 完成" IsChecked="True" Margin="0,2" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="API">
                <StackPanel Margin="12">
                    <StackPanel Margin="0,4">
                        <TextBlock Text="Anthropic OAuth:" FontWeight="Bold" />
                        <Button x:Name="AnthropicAuthBtn" Content="连接..." Width="100" Margin="0,4" />
                    </StackPanel>
                    <StackPanel Margin="0,8">
                        <TextBlock Text="OpenAI API Key:" FontWeight="Bold" />
                        <PasswordBox x:Name="OpenAIKeyBox" Width="300" Margin="0,4"
                                     PasswordChar="•" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Save/Cancel buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="0,12,0,0">
            <Button Content="保存" Width="80" Click="SaveButton_Click"
                    Background="#FF6C63FF" Foreground="White" />
            <Button Content="取消" Width="80" Margin="8,0,0,0" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
