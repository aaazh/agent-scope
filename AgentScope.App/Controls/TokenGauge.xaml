<UserControl x:Class="AgentScope.App.Controls.TokenGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Progress bar -->
        <Border Grid.Row="0" Height="8" CornerRadius="4"
                Background="#FF2D2D44" Margin="0,0,0,4">
            <Border x:Name="ProgressFill" CornerRadius="4"
                    HorizontalAlignment="Left"
                    Width="0"
                    Background="#FF6C63FF" />
        </Border>

        <!-- Labels -->
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock x:Name="TokenLabel"
                       Foreground="#FFF0F0F0"
                       FontSize="11"
                       Text="Token: --" />
            <TextBlock x:Name="PercentLabel"
                       Foreground="#FFA0A0B0"
                       FontSize="11"
                       Margin="8,0,0,0"
                       Text="" />
        </StackPanel>
    </Grid>
</UserControl>
